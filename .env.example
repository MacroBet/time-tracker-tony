# Local demo only: volatile, synthetic data. Never used when DATABASE_URL is set.
DEMO_MODE=true
# Neon pooled connection string. Server only; never use NEXT_PUBLIC_ here.
DATABASE_URL=
# Optional direct connection for migrations (otherwise DATABASE_URL is used).
DATABASE_URL_UNPOOLED=
# Copilot stays disabled until Marco completes secure key setup and authorizes use.
# Server-only. Never place these values in NEXT_PUBLIC_ variables or in chat.
COPILOT_ENABLED=false
OPENAI_API_KEY=
# Select an available model during setup; no paid model is selected automatically.
OPENAI_MODEL=
